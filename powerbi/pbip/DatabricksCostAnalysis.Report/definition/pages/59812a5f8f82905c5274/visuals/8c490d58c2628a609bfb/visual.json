                "textRuns": [
                  {
                    "value": "What this report shows",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#EB6834",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Databricks compute consumption and cost across workspaces, SQL warehouses, job clusters, serverless notebooks, apps and more. Cost is attributed to the identity that drove it (user or service principal): SQL Warehouse cost is split across users in proportion to the queries they ran each day, and everything else is attributed from billing metadata.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Currency conversion",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#EB6834",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cost is DBUs x Databricks list price (USD). It is converted to the LocalCurrency parameter using the Frankfurter API (ECB reference rates): one rate per month = the last available rate on or before the month end.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
