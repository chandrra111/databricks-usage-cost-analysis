table billing_usage
	lineageTag: 7e69ec82-4c52-7562-215a-6da60ed48ca3

	measure 'Total Cost USD' = SUM ( billing_usage[total_usage_price_usd] )
		formatString: #,0.00
		displayFolder: Cost
		lineageTag: febaf5de-2e80-6e9d-8396-009897350ba3

	measure 'Allocated DBUs' = SUM ( billing_usage[allocated_dbus] )
		formatString: #,0
		displayFolder: Usage
		lineageTag: 862477de-7540-2d22-6194-0729c1d38d5f

	measure 'Total Query Count' = SUM ( billing_usage[query_count] )
		formatString: #,0
		displayFolder: Usage
		lineageTag: 41080b8d-33e5-a931-2c19-2ddb9877a51b

	measure 'Total Duration (min)' = SUM ( billing_usage[total_duration_in_min] )
		formatString: #,0
		displayFolder: Usage
		lineageTag: 9478a50e-9fb5-6d19-d9ad-89964002397c

	measure 'Month Rate' = ```
			VAR m = SELECTEDVALUE ( billing_usage[calendar_month] )
			VAR r = LOOKUPVALUE ( fx_rates_monthly[exchange_rate], fx_rates_monthly[calendar_month], m )
			VAR lastKnown =
			    CALCULATE (
			        MAX ( fx_rates_monthly[exchange_rate] ),
			        TOPN ( 1, FILTER ( ALL ( fx_rates_monthly ), fx_rates_monthly[calendar_month] <= m ), fx_rates_monthly[calendar_month], DESC )
			    )
			RETURN COALESCE ( r, lastKnown )
			```
		formatString: 0.0000
		displayFolder: Currency
		lineageTag: 0d4fee65-610a-04bd-82b8-605a6b51d54b

	measure 'Total Cost Local' = ```
			SUMX (
			    VALUES ( billing_usage[calendar_month] ),
			    CALCULATE ( SUM ( billing_usage[total_usage_price_usd] ) ) * [Month Rate]
			)
			```
		formatString: #,0
		displayFolder: Cost
		lineageTag: 1f4bbbb7-36a1-2dbe-f8f2-d89e494fa2a6

	measure 'Exchange Rate' = DIVIDE ( [Total Cost Local], [Total Cost USD] )
		formatString: 0.00
		displayFolder: Currency
		lineageTag: 4f37c7eb-0b35-ea06-d5e3-e9fd7f9c6a08

	measure 'Local Currency' = SELECTEDVALUE ( fx_rates_monthly[local_currency], "USD" )
		displayFolder: Currency
		lineageTag: 50cddd9d-fe9a-4e94-44a8-7ddf547b157e

	measure 'Cost Share %' = DIVIDE ( [Total Cost Local], CALCULATE ( [Total Cost Local], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: fac1b7d0-973e-9c84-e7e8-1a02fb755355

	measure 'Avg Cost per Day' = DIVIDE ( [Total Cost Local], DISTINCTCOUNT ( billing_usage[usage_date] ) )
		formatString: #,0
		displayFolder: Cost
		lineageTag: f5715ffa-568a-4d82-857f-6c360112c4b8

	measure 'Identities with Spend' = CALCULATE ( DISTINCTCOUNT ( billing_usage[attributed_to] ), billing_usage[total_usage_price_usd] > 0 )
		formatString: #,0
		displayFolder: Usage
		lineageTag: 287af09c-3b41-35cd-70ff-679943361e7b

	measure 'Selected Period' = ```
			VAR mn = MIN ( billing_usage[calendar_month] )
			VAR mx = MAX ( billing_usage[calendar_month] )
			RETURN IF ( mn = mx, mn, mn & " to " & mx )
			```
		displayFolder: Labels
		lineageTag: 14d68095-e924-70c6-3ffd-2989a2ecd6ec

	measure 'Cost Title' = "Total cost (" & [Local Currency] & ")"
		displayFolder: Labels
		lineageTag: 6e043fb7-45e1-4f1a-b80b-aa2a32ad3064

	measure 'Last Refreshed' = "Data as of " & FORMAT ( MAX ( billing_usage[usage_date] ), "dd-mmm-yyyy" )
		displayFolder: Labels
		lineageTag: 0bdd4953-5633-022d-b141-1b09d33d003a

